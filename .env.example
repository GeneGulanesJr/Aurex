LAPIS_ENDPOINT=http://localhost:9100
REPO_ROOT=/workspace
GIT_MAIN_BRANCH=main
PORT=3000
WORKER_TIMEOUT_SIMPLE=180000
WORKER_TIMEOUT_BUILD=300000
WORKER_TIMEOUT_TEST_HEAVY=600000
VALIDATOR_TIMEOUT=180000
RESEARCH_TIMEOUT=120000
MAX_VALIDATOR_RETRIES=2
MAX_RESCOPES_PER_MILESTONE=5
VALIDATOR_TOOL_CALL_CAP=0
MISSION_COST_CAP=50.00
MAX_CONCURRENT_MISSIONS=3
# Soft token budget for the affected-code scaffold injected into worker context (issue #114).
AFFECTED_CODE_TOKEN_BUDGET=1200
QUOTA_ENABLED=false
QUOTA_WINDOW_HOURS=5
QUOTA_BURN_HOURS=1
# Auth0 (Google/Gmail login)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.aurex.io
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.aurex.io
# GitHub App OAuth
GITHUB_CLIENT_SECRET=
GITHUB_CLIENT_ID=Iv23lijYF4sZMcU62MjT
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback
GITHUB_FRONTEND_URL=http://localhost:8080

# OpenTelemetry metrics (Docker Compose sends backend metrics to otel-collector).
# Set OTEL_METRICS_EXPORTER=none or OTEL_SDK_DISABLED=true to disable backend metric export.
OTEL_SERVICE_NAME=aurex-backend
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_METRIC_EXPORT_TIMEOUT=10000
