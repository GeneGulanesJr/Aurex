FROM node:22-slim

RUN apt-get update && apt-get install -y git python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Re-clone when LAPIS_PULL changes. Bump the default after LaPis releases, or run:
#   LAPIS_PULL=$(date +%F) docker compose build lapis
ARG LAPIS_PULL=2026-06-15
ARG LAPIS_REF=main
RUN echo "lapis-pull=${LAPIS_PULL}" && git clone --depth 1 --branch "${LAPIS_REF}" https://github.com/GeneGulanesJr/LaPis.git .

RUN npm install

RUN mkdir -p /root/.pi/memory

# Allow git operations on mounted repository directories owned by a
# different host UID (Docker volume mounts preserve host ownership).
# Without this, git refuses to operate on the directory as a security
# safeguard ("dubious ownership").
RUN git config --global --add safe.directory '*'

EXPOSE 9100

HEALTHCHECK --interval=5s --timeout=3s --start-period=15s --retries=10 \
  CMD node -e "fetch('http://localhost:9100/health').then(r=>r.json()).then(j=>{if(j.status!=='ok')process.exit(1)})" || exit 1

CMD ["node", "cli.js", "serve", "--host", "0.0.0.0", "--port", "9100"]
