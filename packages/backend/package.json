{
  "name": "@aurex/backend",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "pnpm --filter @aurex/shared run build && tsc -b --force && cp -r src/migrations dist/migrations",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch --loader ts-node/esm src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aurex/shared": "workspace:*",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^11.9.0",
    "fastify": "^5.3.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0"
  }
}
